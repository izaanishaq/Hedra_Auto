    {
      "parameters": {
        "jsCode": "// Prepare response for manual mode with images and audio\nconst sessionId = $('Webhook Trigger').item.json.body.session_id;\nconst manualMode = $('Webhook Trigger').item.json.body.manual_mode === 'true';\nconst images = [];\n\n// Get audio data - either from ElevenLabs or uploaded\nlet audioData;\nif ($('Merge Audio Paths').all().length > 0) {\n  // Find the audio file from the merged paths\n  const audioItems = $('Merge Audio Paths').all();\n  const audioItem = audioItems.find(item => item.json.id);\n  if (audioItem) {\n    audioData = {\n      id: audioItem.json.id,\n      url: `https://drive.google.com/uc?id=${audioItem.json.id}`,\n      name: audioItem.json.name\n    };\n  }\n}\n\n// Collect generated images\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  images.push({\n    id: item.json.id,\n    url: `https://drive.google.com/uc?id=${item.json.id}`,\n    name: item.json.name\n  });\n}\n\nreturn {\n  session_id: sessionId,\n  images: images,\n  audio: audioData,\n  manual_mode: manualMode,\n  ready: true,\n  timestamp: new Date().toISOString(),\n  image_prompt: $('Generate Prompts').item.json.output.promptImage,\n  video_prompt: $('Generate Prompts').item.json.output.promptVideo\n};"
      },

    {
      "parameters": {
        "jsCode": "// Preprocess script for ElevenLabs - remove emotion tags but keep everything else\nconst originalScript = $input.first().json.user.script;\n\n// Remove emotion tags like [happy], [sad], [angry], etc. but keep the rest\nconst cleanedScript = originalScript.replace(/\\[[^\\]]*\\]/g, '').trim();\n\nreturn {\n  \n  cleaned_script: cleanedScript\n};"
